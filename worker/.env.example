// worker/.env.example — bu dosyayi kopyalayip ".dev.vars" adiyla doldur.
// ".dev.vars" git'e GIRMEZ (store-site/.gitignore). wrangler dev bu dosyayi
// otomatik okur; uretim icin degerler Worker'a "secret" olarak yuklenir:
//   npx wrangler secret put ADMIN_KEY
//   npx wrangler secret put SITE_SESSION_SECRET
//   npx wrangler secret put LOADOUT_KEY
//
// Üretimde değiştirmen gerekenler:
//   ADMIN_KEY           -> panel giriş şifresi (bunu unutursan panele giremezsin)
//   SITE_SESSION_SECRET -> session cookie HMAC anahtarı (>= 32 bayt)
//   LOADOUT_KEY         -> skin/loadout şifreleme anahtarı (32 bayt, base64 veya 64 haneli hex)
//   DISCORD_CLIENT_ID / DISCORD_CLIENT_SECRET -> Discord OAuth (store girişi)
//   DISCORD_WEBHOOK     -> yeni enjeksiyon bildirimi (opsiyonel)
//   PUBLIC_SITE_URL     -> Worker adresi (https://swanchanger.<sub>.workers.dev)

ADMIN_KEY=
SITE_SESSION_SECRET=
LOADOUT_KEY=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_INVITE=
DISCORD_WEBHOOK=
PUBLIC_SITE_URL=
