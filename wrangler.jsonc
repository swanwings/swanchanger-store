// Cloudflare Worker yapilandirmasi (wrangler)
// Kullanım:
//   npx wrangler d1 execute swanchanger --remote --file=./worker/schema.sql
//   npx wrangler secret put ADMIN_KEY        -> panel giris sifresi
//   npx wrangler secret put ADMIN_USER       -> panel giris ismi
//   npx wrangler secret put SITE_SESSION_SECRET
//   npx wrangler secret put LOADOUT_KEY
//   npx wrangler secret put GITHUB_TOKEN     -> private repo (Contents R/W)
//   npx wrangler deploy
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "swanchanger",
  "main": "worker/src/index.mjs",
  "compatibility_date": "2026-01-01",
  "compatibility_flags": ["nodejs_compat"],

  // Statik dosyalar (magaza + indirmeler) Worker'dan servis edilir.
  // PANEL ise private GitHub reposundan cekilir (/admin.html) -> public depoda
  // panel kodu YOK.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/admin*", "/"]
  },

  // D1 (SQLite) - Netlify Blobs KV yerine
  "d1_databases": [
    {
      "binding": "KV",
      "database_name": "swanchanger",
      "database_id": "cad94aac-ff0a-4d0e-8182-88709449deac",
      "migrations_dir": "worker/migrations"
    }
  ],

  "vars": {
    "PUBLIC_SITE_URL": "https://swanchanger.web.app",
    "DLL_SOURCE_URL": "https://raw.githubusercontent.com/swanwings/swanchanger-store/main/public/downloads/SwanChanger.dll",
    "GITHUB_REPO": "swanwings/swanchanger-private",
    "GITHUB_BRANCH": "main",
    "PANEL_ORIGINS": "https://swanwings.github.io",
    "DISCORD_CLIENT_ID": "",
    "DISCORD_INVITE": "",
    "DISCORD_WEBHOOK": ""
  },

  // Loadout degisikliklerini GitHub'a yaz (write-behind + 5 dakikada bir yedek ag)
  "triggers": {
    "crons": ["*/5 * * * *"]
  },

  "observability": {
    "enabled": true
  }
}
