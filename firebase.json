{
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "**/*.exe",
      "**/*.dll",
      "admin.html"
    ],
    "redirects": [
      {
        "source": "/api/report",
        "destination": "https://swanchanger.swanwings.workers.dev/api/report",
        "type": 302
      },
      {
        "source": "/api/community/:path*",
        "destination": "https://swanchanger.swanwings.workers.dev/api/community/:path",
        "type": 302
      },
      {
        "source": "/api/swan/manifest",
        "destination": "https://swanchanger.swanwings.workers.dev/api/swan/manifest",
        "type": 302
      },
      {
        "source": "/api/swan/dll",
        "destination": "https://swanchanger.swanwings.workers.dev/api/swan/dll",
        "type": 302
      },
      {
        "source": "/admin",
        "destination": "https://swanchanger.swanwings.workers.dev/admin",
        "type": 302
      },
      {
        "source": "/admin.html",
        "destination": "https://swanchanger.swanwings.workers.dev/admin.html",
        "type": 302
      },
      {
        "source": "/downloads/SwanChanger.exe",
        "destination": "https://raw.githubusercontent.com/swanwings/swanchanger-store/main/public/downloads/SwanChanger.exe",
        "type": 302
      }
    ],
    "headers": [
      {
        "source": "/index.html",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, must-revalidate" }
        ]
      },
      {
        "source": "/assets/**",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=3600" }
        ]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}
